<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- Compiles the actual Unity Core scripts directly, so the tests
         exercise the exact code the game ships with. Core has no
         UnityEngine dependency (see Assets/Scripts/Core/StrainEmpire.Core.asmdef,
         noEngineReferences: true), so it builds fine as a plain netstandard/net6 lib. -->
    <Compile Include="../../Assets/Scripts/Core/**/*.cs" LinkBase="Core" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.6.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.4" />
  </ItemGroup>

</Project>
